# ==============================================================================
# Git Attributes & Line Endings Normalization
# ==============================================================================

# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# C++ Source and Header files
*.cpp text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf

# Unreal Engine build and project files
*.cs text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.txt text eol=lf

# Excel and Binary Raw Assets
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary

# Unreal Engine Asset Files (Git LFS)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
