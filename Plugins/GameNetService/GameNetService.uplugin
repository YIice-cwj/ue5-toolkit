    "Installed": false,
    "Modules": [
        {
            "Name": "GameNetService",
            "Type": "Runtime",
            "LoadingPhase": "Default"
        }
    ],
    "Plugins": [
        {
            "Name": "GameCore",
            "Enabled": true
        },
        {
            "Name": "GameLogging",
            "Enabled": true
        },
        {
            "Name": "GameNetCore",
            "Enabled": true
        }
    ]
}

